{
  "schema_version": "1.0",
  "campaign_window": {"from":"1933-01-01","to":"1945-12-31"},
  "purpose": "Keep player control continuous through death, resignation, overthrow, exile, liberation, armistice, surrender and occupation without rewriting historical office structures.",
  "control_model": {
    "separate_fields": ["head_of_state", "head_of_government", "control_actor", "player_avatar"],
    "transition_types": ["death", "resignation", "dismissal", "constitutional_succession", "government_in_exile", "regime_split", "liberation", "armistice", "military_surrender", "occupation", "allied_control"],
    "player_rules": {
      "clear_successor": "transfer_player_to_successor_avatar",
      "government_in_exile": "continue_as_exile_government_with_reduced_territorial_control",
      "regime_split": "historical_mode_assigns_team-compatible successor; alternate-history mode may offer a branch choice",
      "occupation_without_sovereign_successor": "transfer_to_occupation_or_resistance_command according to country chain",
      "state_inventory": "remains with the state or successor administration unless an event explicitly removes it",
      "personal_inventory": "follows the avatar unless confiscated, lost, inherited or archived by event",
      "research": "completed national research remains with the country; active projects may suffer disruption penalties",
      "organizations": "corporations and underground organizations survive separately and can change allegiance/influence",
      "no_instant_game_over_on_capital_loss": true
    }
  },
  "countries": {
