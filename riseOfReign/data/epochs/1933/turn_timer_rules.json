{
  "schema_version": "1.1",
  "mode": "turn_timer",
  "permanent_hud": true,
  "default_preset": "turn_5m",
  "display": {
    "office": true,
    "world_map": true,
    "phone": true,
    "meetings": true,
    "warning_thresholds": [0.5, 0.25, 0.1],
    "critical_last_seconds": 30
  },
  "match_presets": {
    "turn_2m": {"turn_seconds": 120, "label": "2 Minuten"},
    "turn_5m": {"turn_seconds": 300, "label": "5 Minuten"},
    "turn_10m": {"turn_seconds": 600, "label": "10 Minuten"},
    "turn_1h": {"turn_seconds": 3600, "label": "1 Stunde"},
    "turn_24h": {"turn_seconds": 86400, "label": "24 Stunden"}
  },
  "timer_change_vote": {
    "enabled": true,
    "eligible_voters": 4,
    "required_yes_votes": 3,
    "approval_rule": "three_of_four",
    "tie_keeps_current_timer": true,
    "one_active_proposal_per_match": true,
    "proposal_options": ["turn_2m", "turn_5m", "turn_10m", "turn_1h", "turn_24h"],
    "applies_from": "next_turn",
    "cannot_change_current_turn_deadline_retroactively": true,
    "all_players_receive_vote_notification": true,
    "vote_is_server_authoritative": true,
    "player_can_change_vote_until_proposal_resolves": true,
    "proposal_closes_when": ["three_yes_votes", "two_no_votes", "all_four_voted", "turn_ends"]
  },
  "phase_rules": {
    "briefing": {"consumes_timer": false},
    "office_decisions": {"consumes_timer": true},
    "phone_or_meeting": {"consumes_timer": true},
    "map_action": {"consumes_timer": true},
    "submit": {"consumes_timer": true},
    "resolve": {"consumes_timer": false}
  },
  "team_rules": {
    "blue_and_red_use_same_deadline": true,
    "team_member_submission_does_not_stop_partner_timer": true,
    "all_four_submitted_resolves_early": true,
    "timer_vote_is_individual_not_team_block_vote": true,
    "no_team_can_change_timer_alone": true
  },
  "timeout_behavior": {
    "never_submit_empty_turn": true,
    "auto_keep_last_safe_economic_policy": true,
    "auto_phone_action": "no_new_commitment",
    "auto_map_action": "inspect_current_supply",
    "auto_decline_irreversible_action": true,
    "auto_cancel_unconfirmed_attack": true,
    "mark_player_timed_out": true,
    "repeat_timeouts_can_enable_ai_takeover_if_match_setting_allows": true
  },
  "fairness": {
    "server_authoritative_deadline": true,
    "client_clock_is_display_only": true,
    "reconnect_uses_server_deadline": true,
    "network_disconnect_does_not_reset_timer": true,
    "host_cannot_extend_only_one_team": true,
    "same_vote_rule_for_host_and_guests": true
  }
}
