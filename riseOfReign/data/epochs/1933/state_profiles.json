{
  "schema_version": "1.0",
  "epoch": 1933,
  "unit_note": "All finance and asset values are normalized gameplay Resource Points (RP), not claims of exact historical currency amounts.",
  "inventory_note": "Starter inventory is gameplay content inspired by role and office context. It is not a claim that the historical person owned each exact object on 1 January 1933.",
  "finance_rules": {
    "treasury_min": 0,
    "treasury_soft_max": 100,
    "monthly_net_formula": "income_total - expense_total",
    "deficit_rule": "If treasury cannot cover a negative monthly net, debt rises and stability/reputation risks unlock.",
    "surplus_rule": "A positive monthly net increases treasury unless allocated to reserves, debt repayment or investment.",
    "income_categories": ["taxes", "customs_tariffs", "state_enterprises", "exports_transfers", "other_income"],
    "expense_categories": ["administration", "civil_supply_welfare", "education_research", "infrastructure", "military_security", "debt_service", "other_expense"],
    "asset_categories": ["gold_reserves", "foreign_exchange", "state_enterprises", "infrastructure_value", "strategic_reserves", "military_stockpiles", "public_property"]
  },
  "health_rules": {
    "scale": "0-100",
    "dimensions": ["health", "energy", "stress", "mobility", "medical_access"],
    "monthly_update": [
      "age pressure is small and gradual",
      "high stress and low energy can reduce health",
      "rest, medical care and successful crisis management can restore energy/stress",
      "injury, illness and dangerous travel are event-driven",
      "mobility is separate from health and never used as a moral or leadership-value penalty by itself"
    ],
    "leadership_effect": "Very low health or energy can reduce leadership capacity, meeting availability and travel options. It does not automatically remove the avatar.",
    "critical_threshold": 20,
    "incapacitated_threshold": 5
  },
  "inventory_rules": {
    "ownership_types": ["personal", "office", "state_issued", "classified"],
    "item_fields": ["id", "label", "category", "ownership", "quantity", "condition", "portable", "effects", "tags"],
    "condition_scale": "0-100",
    "loss_sources": ["travel", "office_damage", "confiscation", "theft_event", "succession", "player_choice"],
    "gain_sources": ["event", "meeting", "research", "office_upgrade", "diplomacy", "purchase", "award"],
    "state_property_rule": "State-issued and classified items normally remain with the office/state on succession; personal items follow avatar succession rules."
  },
