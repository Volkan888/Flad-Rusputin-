{
  "schema_version": "1.0",
  "epoch": 1933,
  "purpose": "Attackable world-map sectors for the initial six major playable countries. Values are gameplay balancing seeds based on geography, infrastructure and strategic context; they are not literal historical troop strengths.",
  "ownership_model": {
    "territorial_owner":"state/country controlling the sector",
    "controller_types":["state","occupation_authority","corporation","mafia_or_criminal_network","political_organization","mixed"],
    "rule":"Non-state actors can hold influence, assets or local control later, but territorial sovereignty and influence are stored separately.",
    "future_power_layers":["corporate_influence","mafia_influence","political_network","religious_institution_influence","military_local_control"]
  },
  "combat_model": {
    "turn_unit":"month",
    "combat_substep":"day",
    "sector_state":["secure","threatened","contested","occupied","resistance","recovering"],
    "base_defense_formula":"terrain_defense*0.25 + fortification*0.15 + urban_defense*0.15 + supply_access*0.15 + infrastructure*0.10 + local_resilience*0.10 + command_access*0.10",
    "dynamic_defense_formula":"base_defense_score * garrison_factor * readiness_factor * supply_factor * morale_factor * command_factor",
    "attack_progress_formula":"attacker_effective_strength / max(defender_effective_strength,1) * attacker_supply_factor * route_access_factor * weather_factor",
    "duration_rule":"Battles resolve in daily progress inside monthly turns. If progress is insufficient by month end, the sector remains contested into the next turn.",
    "duration_bands_days":{"open_plain":[4,18],"mixed":[7,25],"hilly":[10,32],"mountain":[16,60],"major_city":[15,60],"island_or_amphibious":[20,75]},
    "minimum_attack_requirements":["adjacent_land_sector_or_valid_sea_route","available_command_authority","supply_route","combat_capable_force"],
    "strength_factors":["terrain","weather","garrison","fortifications","urbanization","rail_and_road_access","ports","local_supply","morale","communications","air_and_naval_support_if_available","recent_damage","local_unrest","occupation_resistance"],
    "no_instant_capture":true,
    "capital_capture_rule":"Capturing a capital sector creates major authority/logistics effects but does not automatically annex the entire country.",
    "resource_capture_rule":"Resource nodes inside a captured sector require intact transport and local control before full output becomes available."
  },
