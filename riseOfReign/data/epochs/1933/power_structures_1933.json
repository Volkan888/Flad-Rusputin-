{
  "schema_version": "1.0",
  "epoch": 1933,
  "purpose": "Country-specific economic and non-state power structures that can own assets, influence sectors and interact with players. Criminal-network mechanics are abstract strategy values only.",
  "types": [
    "private_company",
    "industrial_group",
    "bank",
    "state_enterprise",
    "state_holding",
    "planning_institution",
    "labor_organization",
    "political_organization",
    "religious_institution",
    "criminal_network",
    "underground_network",
    "media_network"
  ],
  "influence_dimensions": [
    "economic",
    "industrial",
    "labor",
    "political",
    "financial",
    "research",
    "media",
    "local_control",
    "information",
    "security_risk",
    "cultural"
  ],
  "ownership_rules": {
    "territorial_sovereignty_separate": true,
    "sector_influence_max": 100,
    "assets_have_owner": true,
    "state_can_regulate_or_nationalize_through_game_rules": true,
    "corporations_can_span_multiple_sectors": true,
    "criminal_networks_never_own_sovereignty": true,
    "criminal_actions_are_abstract": true,
    "inventory_separation": ["personal", "office", "state", "organization"]
  },
  "organization_inventory": {
    "allowed_categories": ["cash_reserve", "documents", "licenses", "contracts", "vehicles_abstract", "industrial_assets", "communications_assets", "research_assets", "property", "stockpiles_abstract"],
    "rule": "Organization inventory is distinct from the avatar's personal inventory and the state's treasury.",
    "transfer_requires": ["authority_or_contract", "legal_or_event_basis", "storage_or_destination"]
  },
  "interaction_model": {
    "legal_entities": ["negotiate_contract", "appoint_state_liaison", "subsidize", "tax", "regulate", "request_production", "commission_research", "purchase_asset", "sell_asset", "nationalize_if_rules_allow"],
    "criminal_or_underground_entities": ["gather_information", "reduce_or_increase_local_stability", "black_market_pressure", "corruption_risk", "local_influence", "counter_network_action"],
    "safety_note": "No real-world operational crime instructions are represented. Outcomes are resolved by stats, costs, cooldowns and events."
  },
