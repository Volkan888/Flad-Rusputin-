[node name="Features" type="VBoxContainer" parent="MainLayout/Content/FeaturePanel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Era" type="Label" parent="MainLayout/Content/FeaturePanel/Features"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.85, 0.72, 1)
theme_override_font_sizes/font_size = 32
text = "1. JANUAR 1933"
horizontal_alignment = 1

[node name="Description" type="Label" parent="MainLayout/Content/FeaturePanel/Features"]
layout_mode = 2
theme_override_colors/font_color = Color(0.73, 0.7, 0.64, 1)
theme_override_font_sizes/font_size = 20
text = "Führe einen historischen oder eigenen Avatar. Lerne, wie Staatshaushalt, Ressourcen, Verkehrsnetze, Forschung, Diplomatie, Gesundheit und politische Macht zusammenwirken."
autowrap_mode = 2
horizontal_alignment = 1

[node name="LearningCard" type="PanelContainer" parent="MainLayout/Content/FeaturePanel/Features"]
layout_mode = 2
size_flags_vertical = 3

[node name="LearningText" type="Label" parent="MainLayout/Content/FeaturePanel/Features/LearningCard"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.76, 0.65, 1)
theme_override_font_sizes/font_size = 18
text = "SOLO-LERNMODUS\n\n• Bildliche Räume mit Maus-Hotspots\n• KI-gesteuerte Weltlage\n• Historischer Kontext und Quellenkritik\n• Wissensfragen mit Erklärung\n• Kritische Darstellung von Diktatur, Propaganda und Krieg\n• Keine verherrlichende Symbolik in den Spielräumen"
autowrap_mode = 2
vertical_alignment = 1

[node name="Systems" type="Label" parent="MainLayout/Content/FeaturePanel/Features"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.72, 0.62, 1)
theme_override_font_sizes/font_size = 18
text = "BÜRO · WELTKARTE · TELEFON · WIRTSCHAFT\nFORSCHUNG · MILITÄR · DIPLOMATIE · EVENTS"
horizontal_alignment = 1

[node name="EraNote" type="Label" parent="MainLayout/Content/FeaturePanel/Features"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.52, 0.48, 1)
text = "Historische Anker bleiben sichtbar. Entscheidungen verändern Vorbereitung, Reaktion und Folgen."
autowrap_mode = 2
horizontal_alignment = 1

[node name="Footer" type="HBoxContainer" parent="MainLayout"]
layout_mode = 2

[node name="Status" type="Label" parent="MainLayout/Footer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.65, 0.61, 0.55, 1)
text = "Build"

[node name="SoundState" type="Label" parent="MainLayout/Footer"]
layout_mode = 2
