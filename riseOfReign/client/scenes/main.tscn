[node name="Menu" type="VBoxContainer" parent="MainLayout/Content/MenuPanel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="MenuTitle" type="Label" parent="MainLayout/Content/MenuPanel/Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(0.83, 0.79, 0.7, 1)
theme_override_font_sizes/font_size = 22
text = "SPIELMODUS"

[node name="NewGame" type="Button" parent="MainLayout/Content/MenuPanel/Menu" groups=["strategy_menu_button"]]
layout_mode = 2
custom_minimum_size = Vector2(0, 96)
icon = ExtResource("3")
icon_max_width = 38
expand_icon = true
text = "NEUES SPIEL · SOLO-LERNKAMPAGNE"
tooltip_text = "Ein Spieler, KI-Welt, Lernkarten und Wissensfragen"

[node name="SoloNote" type="Label" parent="MainLayout/Content/MenuPanel/Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(0.66, 0.63, 0.57, 1)
text = "Empfohlen: ohne Zeitdruck beginnen, Avatar wählen und Januar 1933 im eigenen Büro spielen."
autowrap_mode = 2

[node name="Continue" type="Button" parent="MainLayout/Content/MenuPanel/Menu" groups=["strategy_menu_button"]]
layout_mode = 2
custom_minimum_size = Vector2(0, 76)
text = "FORTSETZEN"

[node name="Multiplayer" type="Button" parent="MainLayout/Content/MenuPanel/Menu" groups=["strategy_menu_button"]]
layout_mode = 2
