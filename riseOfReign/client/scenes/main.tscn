[node name="Description" type="Label" parent="MainLayout/Content/FeaturePanel/Features/TextBlock"]
layout_mode = 2
theme_override_colors/font_color = Color(0.76, 0.71, 0.63, 1)
theme_override_font_sizes/font_size = 19
text = "Baue eine fiktive Figur von der Geburt an auf. Jede Frage ist ein Event mit sichtbaren Folgen für Gesundheit, Bildung, Charakter, Kontakte, Inventar und das erste Büro."
autowrap_mode = 2
horizontal_alignment = 1

[node name="LearningCard" type="PanelContainer" parent="MainLayout/Content/FeaturePanel/Features/TextBlock"]
layout_mode = 2
size_flags_vertical = 3
theme_override_styles/panel = SubResource("PortraitPanel")

[node name="LearningText" type="Label" parent="MainLayout/Content/FeaturePanel/Features/TextBlock/LearningCard"]
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.78, 0.67, 1)
theme_override_font_sizes/font_size = 17
text = "SOLO-PROLOG\n\n• 13 spielbare Biografie-Events\n• sichtbares Gesicht in drei Lebensphasen\n• vier eigenständige Vertraute\n• Inventar als echte Gegenstände\n• automatische Speicherung nach jeder Antwort\n• Übergabe der aufgebauten Figur an den 1. Januar 1933"
autowrap_mode = 2
vertical_alignment = 1

[node name="Systems" type="Label" parent="MainLayout/Content/FeaturePanel/Features/TextBlock"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.71, 0.6, 1)
theme_override_font_sizes/font_size = 17
text = "GEBURT · KINDHEIT · SCHULE · ARBEIT · NETZWERK\nINVENTAR · BÜRO · EVENTS · KAMPAGNE"
horizontal_alignment = 1

[node name="EraNote" type="Label" parent="MainLayout/Content/FeaturePanel/Features/TextBlock"]
layout_mode = 2
theme_override_colors/font_color = Color(0.58, 0.55, 0.5, 1)
text = "Flad ist fiktiv. Historische Zusammenhänge werden kritisch eingeordnet und von Spielwerten getrennt."
autowrap_mode = 2
horizontal_alignment = 1

