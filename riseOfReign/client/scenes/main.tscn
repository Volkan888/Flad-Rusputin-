[node name="Publisher" type="Label" parent="MainLayout/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.62, 0.36, 1)
theme_override_font_sizes/font_size = 18
text = "VK APPS PRÄSENTIERT"

[node name="Title" type="Label" parent="MainLayout/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.91, 0.8, 1)
theme_override_font_sizes/font_size = 78
text = "RISE OF REIGN"

[node name="Subtitle" type="Label" parent="MainLayout/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.77, 0.12, 0.15, 1)
theme_override_font_sizes/font_size = 25
text = "1933 · THE WORLD IN CRISIS · HISTORISCHES STRATEGIE- UND LERNSPIEL"

[node name="Rule" type="ColorRect" parent="MainLayout/Header"]
layout_mode = 2
custom_minimum_size = Vector2(0, 3)
color = Color(0.5, 0.04, 0.055, 0.9)

[node name="Content" type="HSplitContainer" parent="MainLayout"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 680

[node name="MenuPanel" type="PanelContainer" parent="MainLayout/Content"]
layout_mode = 2
