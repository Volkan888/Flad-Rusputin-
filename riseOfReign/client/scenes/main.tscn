[gd_scene load_steps=2 format=3]

[ext_resource path="res://scripts/main.gd" type="Script" id="1"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 96.0
offset_right = -48.0
offset_bottom = -96.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "riseOfReign"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Von der Geburt der Avatare bis zur Welt von 1933"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Status" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Initialisiere…"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Start" type="Button" parent="Margin/VBox"]
layout_mode = 2
text = "Prolog starten"

[connection signal="pressed" from="Margin/VBox/Start" to="." method="_on_start_pressed"]
