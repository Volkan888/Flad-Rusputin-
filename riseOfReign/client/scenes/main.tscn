[node name="Description" type="Label" parent="MainLayout/Content/FeaturePanel/Features"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.66, 0.61, 1)
text = "Führe einen Avatar von seiner persönlichen Steuerzentrale aus. Staatshaushalt, Ressourcen, Diplomatie, Forschung, Aufrüstung und Gesundheit laufen gleichzeitig."
autowrap_mode = 2
horizontal_alignment = 1

[node name="Systems" type="Label" parent="MainLayout/Content/FeaturePanel/Features"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.78, 0.68, 1)
theme_override_font_sizes/font_size = 22
text = "BÜRO  ·  WELTKARTE  ·  TELEFON\nWIRTSCHAFT  ·  FORSCHUNG  ·  MILITÄR\nDIPLOMATIE  ·  INVENTAR  ·  EREIGNISSE"
horizontal_alignment = 1

[node name="EraNote" type="Label" parent="MainLayout/Content/FeaturePanel/Features"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.55, 0.52, 0.48, 1)
text = "Historische Anker bleiben bestehen. Deine Entscheidungen verändern die Lage, Ressourcen, Macht und Beziehungen darum herum."
autowrap_mode = 2
vertical_alignment = 1
horizontal_alignment = 1

